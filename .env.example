# Local secrets for docker compose. Copy to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored — never commit real keys. In production these come from a
# secrets manager, not a file (architecture §6.2).

# Embeddings for ingestion-service, via the LiteLLM proxy. Required to ingest
# documents and to run any retrieval query, since the query is embedded with the
# same model that embedded the chunks.
OPENAI_API_KEY=sk-...

# Claude, for ai-service (Deal Q&A). Without it the service starts and reports
# unhealthy, and /ai/v1/deals/{id}/ask returns 503 rather than failing obscurely.
ANTHROPIC_API_KEY=sk-ant-...
