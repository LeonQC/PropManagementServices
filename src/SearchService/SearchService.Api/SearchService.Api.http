@host = http://localhost:5600
# The Postgres-backed fallback path. Same params, same response shape — run the two
# side by side to diff them (see "Parity checks" below).
@listingsHost = http://localhost:5100
# The index itself, for when you need to see what the service is actually querying.
@opensearch = http://localhost:9200
# A seeded property id. Swap for one from a list call.
@propertyId = 228d468f-592e-480e-bdeb-2d338b16d3ea

# The Postgres-backed deals path, for the same side-by-side diffing.
@dealsHost = http://localhost:5200
# A deal id. Swap for one from a list call.
@dealId = 2fa1bf70-9257-4b82-98b1-a2195121b2b1
# Deals are authorized data. Paste an access token from POST {{authHost}}/auth/v1/login —
# both hosts accept the same one, since both validate against auth-service's JWKS.
@authHost = http://localhost:5300
@token = paste-an-access-token-here

### Health — index reachability + live document count
GET {{host}}/search/v1/health
Accept: application/json

# ─────────────────────────────────────────────────────────────────────────────
# The grid query. Identical contract to GET /listings/v1/properties.
# ─────────────────────────────────────────────────────────────────────────────

### List properties (paginated, default sort = newest first)
GET {{host}}/search/v1/properties?page=1&pageSize=5
Accept: application/json

### Page 2 — pagination is stable (every sort carries an id tiebreaker)
GET {{host}}/search/v1/properties?page=2&pageSize=5
Accept: application/json

### Sort: price high → low
GET {{host}}/search/v1/properties?page=1&pageSize=5&sort=price_desc
Accept: application/json

### Sort: price low → high
GET {{host}}/search/v1/properties?page=1&pageSize=5&sort=price_asc
Accept: application/json

### Sort: cap rate high → low
GET {{host}}/search/v1/properties?page=1&pageSize=5&sort=cap_desc
Accept: application/json

### Filter: property type
GET {{host}}/search/v1/properties?page=1&pageSize=5&propertyType=Industrial
Accept: application/json

### Filter: status
GET {{host}}/search/v1/properties?page=1&pageSize=5&status=listed
Accept: application/json

### Filter: metro area
GET {{host}}/search/v1/properties?page=1&pageSize=5&metroArea=Portland%20Metro
Accept: application/json

### Filter: price range
GET {{host}}/search/v1/properties?page=1&pageSize=5&minPrice=5000000&maxPrice=25000000
Accept: application/json

### Everything composed — filters + keyword + sort
GET {{host}}/search/v1/properties?page=1&pageSize=5&propertyType=Industrial&status=listed&sort=relevance&q=park
Accept: application/json

# ─────────────────────────────────────────────────────────────────────────────
# Keyword search — what OpenSearch does that the Postgres tsvector could not.
# Run each against {{listingsHost}} too; the difference is the point.
# ─────────────────────────────────────────────────────────────────────────────

### Exact term — 8 hits, same as Postgres
GET {{host}}/search/v1/properties?page=1&pageSize=10&q=warehouse
Accept: application/json

### TYPO tolerance — "warehse" still finds warehouses (Postgres returned 0)
GET {{host}}/search/v1/properties?page=1&pageSize=10&q=warehse
Accept: application/json

### PREFIX / search-as-you-type — a half-typed word matches title AND description
GET {{host}}/search/v1/properties?page=1&pageSize=10&q=wareh
Accept: application/json

### LOOSE MULTI-WORD — no longer all-or-nothing (Postgres AND'd every term: 2 hits)
GET {{host}}/search/v1/properties?page=1&pageSize=10&q=industrial%20park%20portland
Accept: application/json

### Short queries still require every term ("2<70%"), so this stays tight
GET {{host}}/search/v1/properties?page=1&pageSize=10&q=cold%20storage
Accept: application/json

### Matches text that lives only in the description
GET {{host}}/search/v1/properties?page=1&pageSize=10&q=tenant
Accept: application/json

### RELEVANCE sort — ranks by BM25 score; only meaningful with a keyword.
# Expect Portland on top: the query terms are spread across title + city, and documents
# containing all of them outrank a great match on title alone.
GET {{host}}/search/v1/properties?page=1&pageSize=5&sort=relevance&q=industrial%20park%20portland
Accept: application/json

# ─────────────────────────────────────────────────────────────────────────────
# Parity checks — the same request against both backends.
# Structured queries must match exactly; keyword queries are expected to differ.
# ─────────────────────────────────────────────────────────────────────────────

### OpenSearch path
GET {{host}}/search/v1/properties?page=1&pageSize=10&propertyType=Office&status=listed&sort=cap_desc
Accept: application/json

### Postgres path — same params, must return the same items in the same order
GET {{listingsHost}}/listings/v1/properties?page=1&pageSize=10&propertyType=Office&status=listed&sort=cap_desc
Accept: application/json

# ─────────────────────────────────────────────────────────────────────────────
# Index plumbing. The service owns these; hit them directly when a result looks wrong.
# ─────────────────────────────────────────────────────────────────────────────

### Republish every property snapshot from listings-service (rebuilds the feed).
# Only needed for rows that predate the snapshot topic — after that, reindexing is a pure
# Kafka replay. Safe to re-run: external versioning rejects unchanged documents.
POST {{listingsHost}}/listings/v1/properties/republish

### Cluster health
GET {{opensearch}}/_cluster/health

### Root document count. NOTE: /_cat/indices reports a much larger number because it also
# counts the nested `features` sub-documents — this is the one that matches the grid total.
GET {{opensearch}}/properties/_count

### The alias and the index it points at (reads go through the alias so the index can be
# rebuilt and swapped underneath them)
GET {{opensearch}}/_alias/properties

### Field mapping — check analyzers and types when matching behaves unexpectedly
GET {{opensearch}}/properties_v1/_mapping

### A single indexed document, as the consumer wrote it
GET {{opensearch}}/properties/_doc/{{propertyId}}

### See how text is tokenised — the fastest way to explain "why didn't this match?"
POST {{opensearch}}/properties_v1/_analyze
Content-Type: application/json

{
  "analyzer": "proptrack_text",
  "text": "Warehouses in Portland's Pearl District"
}

# ═════════════════════════════════════════════════════════════════════════════
# DEALS
#
# Identical contract to GET /deals/v1/deals — same query params, same {data, meta}
# envelope — so switching is a base-path change. Two differences from properties:
# these require a bearer token, and there is no `sort` param (deals order newest-first,
# or by relevance once a keyword is present).
# ═════════════════════════════════════════════════════════════════════════════

### Log in to get a token for the calls below. Copy data.accessToken into @token.
# @name login
POST {{authHost}}/auth/v1/login
Content-Type: application/json

{
  "email": "admin@proptrack.local",
  "password": "ChangeMe123!"
}

### List deals (paginated, newest first)
GET {{host}}/search/v1/deals?page=1&pageSize=5
Authorization: Bearer {{token}}
Accept: application/json

### Without a token — 401. Properties stay anonymous; deals don't.
GET {{host}}/search/v1/deals?pageSize=1
Accept: application/json

# ── Structured filters. Every one of these must return the same totalCount and the
#    same ordering as the {{dealsHost}} twin below it.

### By stage
GET {{host}}/search/v1/deals?stage=NdaLoi&pageSize=200
Authorization: Bearer {{token}}

### By owner (an optional filter, not a scoping rule — the list is not per-user)
GET {{host}}/search/v1/deals?ownerId=11111111-2222-3333-4444-555555555555&pageSize=200
Authorization: Bearer {{token}}

### Price and cap-rate ranges
GET {{host}}/search/v1/deals?offerPriceMin=5000000&offerPriceMax=40000000&capRateMin=0.05&pageSize=200
Authorization: Bearer {{token}}

### Close-date window (bounds are exclusive, matching the Postgres CompareTo)
GET {{host}}/search/v1/deals?closeDateAfter=2026-03-01&closeDateBefore=2026-11-01&pageSize=200
Authorization: Bearer {{token}}

### Overdue tasks — a range over the indexed earliest open due date, evaluated against
# today. Nothing is reindexed when a task tips over; the query asks the question fresh.
GET {{host}}/search/v1/deals?hasOverdueTasks=true&pageSize=200
Authorization: Bearer {{token}}

### ...and its complement. These two must partition the whole set.
GET {{host}}/search/v1/deals?hasOverdueTasks=false&pageSize=200
Authorization: Bearer {{token}}

### Stale deals — at least N days in the current stage. Same deal: a date range, not a
# precomputed flag, so the answer moves with the clock.
GET {{host}}/search/v1/deals?staleDays=30&pageSize=200
Authorization: Bearer {{token}}

# ── Keyword search. These are *expected* to differ from Postgres — that's the point.
#    The deals tsvector covers name and property name only; the index also carries the
#    text of each deal's recent comments and documents, and tolerates typos.

### Comment text. Postgres: 0 hits. OpenSearch: finds the deal whose discussion says it.
GET {{host}}/search/v1/deals?q=cold storage&pageSize=200
Authorization: Bearer {{token}}

### Typo tolerance (fuzziness: AUTO). Postgres: 0 hits.
GET {{host}}/search/v1/deals?q=warehse&pageSize=200
Authorization: Bearer {{token}}

### Document file names. Postgres: 0 hits.
GET {{host}}/search/v1/deals?q=rent-roll&pageSize=200
Authorization: Bearer {{token}}

### A name both backends match — the agreement case, for contrast with the three above.
GET {{host}}/search/v1/deals?q=Nashville&pageSize=200
Authorization: Bearer {{token}}

# ── Parity checks. Run each pair and diff totalCount + the id ordering.

### Postgres twin of the stage filter
GET {{dealsHost}}/deals/v1/deals?stage=NdaLoi&pageSize=200
Authorization: Bearer {{token}}

### Postgres twin of the overdue filter
GET {{dealsHost}}/deals/v1/deals?hasOverdueTasks=true&pageSize=200
Authorization: Bearer {{token}}

### Postgres twin of the stale filter
GET {{dealsHost}}/deals/v1/deals?staleDays=30&pageSize=200
Authorization: Bearer {{token}}

# ── Deal index plumbing

### Republish every deal snapshot (backfill / drift repair). Safe to re-run: external
# versioning rejects unchanged documents rather than rewriting them — watch _seq_no.
POST {{dealsHost}}/deals/v1/deals/republish
Authorization: Bearer {{token}}

### Document count. Compare against `SELECT count(*) FROM deals;`
GET {{opensearch}}/deals/_count

### The alias and the index behind it
GET {{opensearch}}/_alias/deals

### Field mapping — the date `format` entries are the ones worth checking first when a
# sort or range behaves oddly. Deals store ISO-8601 round-trip ("O", 7 fractional
# digits), unlike properties' "yyyy-MM-dd HH:mm:ss".
GET {{opensearch}}/deals_v1/_mapping

### A single indexed deal, as the consumer wrote it. `body` is the flattened text —
# name, property, metro, plus comment and document text.
GET {{opensearch}}/deals/_doc/{{dealId}}

### Version + seq_no, to watch external versioning reject a redundant republish.
# Run it, republish, run it again: both must be unchanged.
POST {{opensearch}}/deals/_search
Content-Type: application/json

{
  "size": 5,
  "version": true,
  "seq_no_primary_term": true,
  "_source": false,
  "sort": [{ "entityId": "asc" }]
}

# ═════════════════════════════════════════════════════════════════════════════
# CROSS-ENTITY
#
# One query over the proptrack_search group alias, spanning properties_v1 and
# deals_v1. Both mappings declare title and body identically — same types, same
# analyzers — which is what makes ranking across them meaningful.
#
# Authenticated, because the results can include deals.
# ═════════════════════════════════════════════════════════════════════════════

### Search everything, ranked by score
GET {{host}}/search/v1/all?q=portland&pageSize=10
Authorization: Bearer {{token}}
Accept: application/json

### Narrow to one type
GET {{host}}/search/v1/all?q=portland&entityType=deal&pageSize=10
Authorization: Bearer {{token}}

### A term that lives in a deal's comments and in property descriptions — one query
# now returns both, which is the whole point of the shared envelope.
GET {{host}}/search/v1/all?q=cold storage&pageSize=10
Authorization: Bearer {{token}}

### No keyword — browse the whole corpus (every document scores the same)
GET {{host}}/search/v1/all?pageSize=5
Authorization: Bearer {{token}}

### Group alias membership — must list BOTH indices. The check that keeps it that way is
# per-index (HEAD /{index}/_alias/{alias}); the unscoped form answers 200 once either
# index has joined, so the second would silently never be added.
GET {{opensearch}}/_alias/proptrack_search

### Combined document count across the alias (properties + deals)
GET {{opensearch}}/proptrack_search/_count
