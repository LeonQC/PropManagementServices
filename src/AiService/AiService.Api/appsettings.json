{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AiDb": "Host=localhost;Port=5436;Database=proptrack_ai;Username=proptrack;Password=proptrack"
  },
  "Jwt": {
    "Issuer": "proptrack-auth",
    "Audience": "proptrack",
    "JwksUrl": "http://localhost:5300/auth/v1/.well-known/jwks.json"
  },
  "Ingestion": {
    "BaseUrl": "http://localhost:5500",
    "TimeoutSeconds": 30
  },
  "Deals": {
    "BaseUrl": "http://localhost:5200",
    "TimeoutSeconds": 15
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "MaxTokens": 1024,
    "TimeoutSeconds": 60,
    "InputCostPerMillionTokens": 3.0,
    "OutputCostPerMillionTokens": 15.0
  },
  "Retrieval": {
    "FetchTopK": 20,
    "MaxContextChunks": 8,
    "MinScore": 0.15,
    "RelativeFloor": 0.55,
    "MaxContextChars": 24000
  }
}
