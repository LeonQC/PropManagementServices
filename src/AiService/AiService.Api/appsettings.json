{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AiDb": "Host=localhost;Port=5436;Database=proptrack_ai;Username=proptrack;Password=proptrack",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "proptrack-auth",
    "Audience": "proptrack",
    "JwksUrl": "http://localhost:5300/auth/v1/.well-known/jwks.json"
  },
  "Ingestion": {
    "BaseUrl": "http://localhost:5500",
    "TimeoutSeconds": 30
  },
  "Deals": {
    "BaseUrl": "http://localhost:5200",
    "TimeoutSeconds": 15
  },
  "Search": {
    "BaseUrl": "http://localhost:5600",
    "TimeoutSeconds": 15
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ConsumerGroupId": "ai-service"
  },
  "Worker": {
    "Enabled": true,
    "RationaleEnabled": true,
    "MaterialScoreDelta": 5.0,
    "MaxConcurrentModelCalls": 1,
    "MinCallIntervalMs": 1500,
    "RationaleModel": "rationale-default",
    "MaxRationaleTokens": 160
  },
  "LiteLlm": {
    "BaseUrl": "http://localhost:4000",
    "TimeoutSeconds": 30
  },
  "Anthropic": {
    "Model": "claude-sonnet-5",
    "AssistantModel": "claude-sonnet-5",
    "MaxTokens": 1024,
    "AssistantMaxTokens": 4096,
    "TimeoutSeconds": 60,
    "ModelRates": {
      "claude-opus-5": { "InputPerMillion": 5.0, "OutputPerMillion": 25.0 },
      "claude-sonnet-5": { "InputPerMillion": 2.0, "OutputPerMillion": 10.0 },
      "claude-haiku-4-5": { "InputPerMillion": 1.0, "OutputPerMillion": 5.0 }
    }
  },
  "Retrieval": {
    "FetchTopK": 20,
    "MaxContextChunks": 12,
    "MinScore": 0.35,
    "RelativeFloor": 0.55,
    "MaxContextChars": 24000
  },
  "RateLimit": {
    "Enabled": true,
    "KeyPrefix": "ai:rl",
    "Assistant": {
      "PermitLimit": 10,
      "WindowSeconds": 300,
      "ConcurrentRequests": 1,
      "LeaseTtlSeconds": 120,
      "BusyRetryAfterSeconds": 60
    },
    "DealQa": {
      "PermitLimit": 30,
      "WindowSeconds": 300,
      "ConcurrentRequests": 2,
      "LeaseTtlSeconds": 90,
      "BusyRetryAfterSeconds": 12
    }
  },
  "Assistant": {
    "MaxIterations": 6,
    "MaxToolCalls": 12,
    "CandidateCap": 10,
    "MaxContextChars": 48000,
    "WallClockSeconds": 90,
    "MaxHistoryTurns": 10,
    "MaxQuestionChars": 2000
  }
}
