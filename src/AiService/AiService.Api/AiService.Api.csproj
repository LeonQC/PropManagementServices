<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AiService.Business\AiService.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serves the assistant's read-only tools to outside MCP clients (Claude Desktop,
         Claude Code) at /mcp. Lives in the Api: MCP is another transport over the same
         Business-layer tools, like the controllers are. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.0" />
    <!-- Backs the per-user rate limits, which have to be shared across replicas.
         Referenced by the Api rather than by Business: limiting is a transport
         concern and lives entirely in Infrastructure alongside the middleware. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Strict N-tier: Api can only compile against Business (its direct
         reference). Models and DataAccess types are invisible here, so the
         Api physically cannot touch entities or EF Core. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

</Project>
