<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AiService.DataAccess\AiService.DataAccess.csproj" />
    <!-- The Kafka worker half (architecture §2.6). Referenced from Business, not Api, so
         the Api never sees Confluent types — same placement as every other service. -->
    <ProjectReference Include="..\..\Shared\PropTrack.Messaging\PropTrack.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Claude client. The Business layer owns the model call the same way it owns
         the repository call: the Api never sees the SDK. -->
    <PackageReference Include="Anthropic.SDK" Version="5.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
